{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "External AI fact-check v1",
  "type": "object",
  "properties": {
    "format": {
      "const": "morrowdock-ai-review-v1"
    },
    "courseId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,80}$"
    },
    "courseVersion": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$"
    },
    "contentSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^@\\r\\n]+$"
    },
    "provider": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "\\S"
    },
    "checkedAt": {
      "type": "string",
      "format": "date-time"
    },
    "verdict": {
      "enum": [
        "pass",
        "changes-requested"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "\\S"
          },
          "claim": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "assessment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 12000,
            "pattern": "\\S"
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 2048,
              "format": "uri",
              "pattern": "^https://[^/@\\s?#]+(?:[/?#][^\\s]*)?$"
            },
            "minItems": 1,
            "maxItems": 10000
          }
        },
        "required": [
          "item",
          "claim",
          "assessment",
          "sources"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 10000
    },
    "limitations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000,
      "pattern": "\\S"
    }
  },
  "required": [
    "format",
    "courseId",
    "courseVersion",
    "contentSha256",
    "reviewer",
    "provider",
    "model",
    "runId",
    "checkedAt",
    "verdict",
    "scope",
    "findings",
    "limitations"
  ],
  "additionalProperties": false
}
